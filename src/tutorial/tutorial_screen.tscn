theme_override_constants/outline_size = 9
theme_override_font_sizes/font_size = 35
text = "Factories are special tiles that spawn automatically and randomly
on the map. Your goal is to create connections between them.

Left-click a factory tile to see its inputs (blue arrows) and outputs (orange arrows).
Other factories will also highlight in respective colours if they accept the item
produced by the selected one.

Click an orange arrow of one factory and a blue one of another to create a connection."
horizontal_alignment = 1

